<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>CmdV</string>
	<key>CFBundleDisplayName</key>
	<string>CmdV</string>
	<key>CFBundleIdentifier</key>
	<string>com.babcock.cmdv</string>
	<key>CFBundleExecutable</key>
	<string>CmdV</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__BUILD__</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Robert Babcock</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<key>NSAppleEventsUsageDescription</key>
	<string>CmdV needs to send Cmd+V to the app you're pasting into.</string>

	<!-- Sparkle. SUPublicEDKey is the public half of the EdDSA key pair whose
	     private half lives in the release machine's login Keychain; Sparkle
	     refuses any update whose signature it can't verify against this key,
	     which is what makes updates safe to serve over a plain static feed. -->
	<key>SUFeedURL</key>
	<string>https://russ-babcock.github.io/cmdv/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>PLWq9xAI2fvUv2AOdTvz0SPYRuZTfgEbKMNbVebBm0w=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
</dict>
</plist>
